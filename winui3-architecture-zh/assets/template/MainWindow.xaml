<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MyApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyApp"
    Title="MyApp">

    <!-- The backdrop is composited BEHIND the content. Never give RootGrid,
         NavigationView or the page root an opaque background while a backdrop
         is active, or it will be hidden. When the user selects "None", paint
         RootGrid yourself (see ApplyBackdrop in the code-behind). -->
    <Window.SystemBackdrop>
        <local:MicaSystemBackdrop x:Name="AppBackdrop" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar strip. Drag anywhere on this element. -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="32" Background="Transparent">
            <TextBlock Text="MyApp"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- PaneDisplayMode="Auto" 提供桌面应用的三档标准模式：
             ≥ ExpandedModeThresholdWidth → Left（导航栏并排，OpenPaneLength 宽）
             两阈值之间                    → LeftCompact（48 px 图标栏，并排）
             < CompactModeThresholdWidth   → LeftMinimal（导航栏浮在内容上）
             LeftMinimal 下汉堡按钮会压住页面标题，所以代码在 Minimal 档给
             ContentFrame 加 48 px 顶部留白（见 NavView_DisplayModeChanged）。
             如果永远不想要悬浮导航栏，直接把 PaneDisplayMode 钉死为 "Left"。 -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Auto"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="200"
                        CompactModeThresholdWidth="560"
                        ExpandedModeThresholdWidth="1008"
                        DisplayModeChanged="NavView_DisplayModeChanged"
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="Home" Tag="home" />
                <NavigationViewItem Content="Second page" Tag="second">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A0;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Settings lives in the footer so its position and icon are under
                 your control (IsSettingsVisible="False" above). -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Icon="Setting" Content="Settings" Tag="settings" />
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>

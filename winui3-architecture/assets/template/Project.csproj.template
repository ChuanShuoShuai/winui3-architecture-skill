<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>MyApp</RootNamespace>
    <AssemblyName>MyApp</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Unpackaged deployment: no MSIX, no Store, plain exe + folder. -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Ship the Windows App SDK runtime inside the output folder.
         Note this is independent of <SelfContained> (the .NET runtime). -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Keep only the localisation folders you actually support.
         Removing the rest saves tens of megabytes. -->
    <SatelliteResourceLanguages>zh-Hans;zh-Hant;en-US</SatelliteResourceLanguages>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationTitle>MyApp</ApplicationTitle>
    <!-- Optional: put an .ico next to this file and uncomment. Leaving it unset
         is fine — the app just uses the default window/exe icon. -->
    <!-- <ApplicationIcon>app.ico</ApplicationIcon> -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Use the Windows App SDK version that matches the SDK installed on the
         machine. These are the versions this template was built and launched
         against (.NET 10.0.402, Windows 11). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

</Project>
